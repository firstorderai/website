{
  "buildCommand": "NEXT_PUBLIC_BASE_URL=\"${NEXT_PUBLIC_BASE_URL:-https://$NEXT_PUBLIC_VERCEL_URL}\" yarn build",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "firstorder.cn"
        }
      ],
      "destination": "/zh-CN"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "firstorder.com.cn"
        }
      ],
      "destination": "/zh-CN"
    }
  ]
}
